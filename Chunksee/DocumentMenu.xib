<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="26000" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="26000"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSObject"/>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <menu title="File" id="file-menu">
            <items>
                <menuItem title="Open…" keyEquivalent="o" id="open">
                    <connections><action selector="openDocument:" target="-1" id="open-action"/></connections>
                </menuItem>
                <menuItem title="Open Recent" id="recent-item">
                    <menu key="submenu" title="Open Recent" systemMenu="recentDocuments" id="recent-menu">
                        <items>
                            <menuItem title="Clear Menu" id="clear-recent">
                                <connections><action selector="clearRecentDocuments:" target="-1" id="clear-action"/></connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="separator"/>
                <menuItem title="Close" keyEquivalent="w" id="close">
                    <connections><action selector="performClose:" target="-1" id="close-action"/></connections>
                </menuItem>
                <menuItem title="Close All" keyEquivalent="w" id="close-all">
                    <modifierMask key="keyEquivalentModifierMask" option="YES" command="YES"/>
                    <connections><action selector="closeAllDocuments:" target="-2" id="close-all-action"/></connections>
                </menuItem>
            </items>
        </menu>
    </objects>
</document>
