{
  "sourceLanguage" : "en",
  "strings" : {
    "Searching farther away…" : {
      "comment" : "Block search list state while background counting expands outward from this window's captured point. Never an item caption."
    },
    "The selected Minecraft files do not provide an ore list." : {
      "comment" : "Block search explanation when the game's ore tag is unavailable. Individually supported blocks can still have results."
    },
    "Chunksee can’t read this folder as a world." : {
      "comment" : "Folder-opening failure. The folder may be invalid, or a restored dimension may lack remembered access to its containing world. Do not assert that the world is invalid."
    },
    "Open the world’s folder inside your saves folder." : {
      "comment" : "Recovery for a folder-opening failure: select the containing world folder to supply access to its saved dimensions."
    },
    "Minecraft %@ doesn't recognize this block" : {
      "comment" : "Block notice. The placeholder is the selected game files' version name; do not translate it."
    },
    "Minecraft doesn't recognize this block" : {
      "comment" : "Block notice when the selected game files have no readable version name."
    },
    "Minecraft %@ would remove it when this area loads." : {
      "comment" : "Help for the block notice. The placeholder is the selected game's version name; do not translate it."
    },
    "Minecraft would remove it when this area loads." : {
      "comment" : "Help for the block notice when the selected game files have no readable version name."
    },
    "Minecraft %@ doesn't recognize this block. It would remove it when this area loads." : {
      "comment" : "Spoken block notice. The placeholder is the selected game files' version name; do not translate it."
    },
    "Minecraft doesn't recognize this block. It would remove it when this area loads." : {
      "comment" : "Spoken block notice when the selected game files have no readable version name."
    },
    "Use Game Artwork" : {
      "comment" : "App-wide View menu toggle: use pictures and texture colors from the chosen game files. Game data and saved map pictures remain available when off."
    },
    "Saved Dimension" : {
      "comment" : "Map inspector label for the original saved dimension value when it cannot be resolved to a dimension."
    },
    "Nothing is drawn on this map." : {
      "comment" : "Explains a saved in-game map whose picture contains only blank pixels."
    },
    "Saved Map Picture" : {
      "comment" : "Inspector section and accessibility label for an in-game map picture whose dimension is unavailable."
    },
    "Newer Minecraft World" : {
      "comment" : "Title for the non-blocking comparison of a saved world's version with the selected game files."
    },
    "Dismiss Notice" : {
      "comment" : "Accessible title of the version notice's close button. Dismissing the banner keeps the information in World Info."
    },
    "The version notice remains in World Info" : {
      "comment" : "Help for dismissing the newer-world banner."
    },
    "This world was saved with Minecraft %@, which is newer than the selected Minecraft %@. Chunksee will show what it can read." : {
      "comment" : "Non-blocking notice. The first name comes from the save; the second comes from the selected game files. Do not translate version names."
    },
    "This world was saved with a newer Minecraft version than the selected Minecraft %@. Chunksee will show what it can read." : {
      "comment" : "Non-blocking notice when the save records a newer data version but no version name. The name comes from the selected game files."
    },
    "Mobs" : {
      "comment" : "Sidebar section listing only creature types with saved individuals in this dimension."
    },
    "Saved Mobs" : {
      "comment" : "Mob-type inspector count of saved individuals."
    },
    "Appearances" : {
      "comment" : "Mob-type inspector section for saved variants, markings and other appearance traits."
    },
    "All Appearances" : {
      "comment" : "Map filter choice that includes every saved appearance of this mob type."
    },
    "Not recorded" : {
      "comment" : "A saved mob has no recorded appearance facts; no default appearance is invented."
    },
    "These positions come from the last save. Mobs may move or disappear when the world is played." : {
      "comment" : "Mob-type inspector explains that saved positions are a snapshot, not live mob tracking."
    },
    "creature: saved mobs" : {
      "comment" : "Search syntax hint: creature searches all saved mobs, including ordinary unnamed ones."
    },
    "Abandoned Camps" : {
      "comment" : "Sidebar structure family supplied by the game's abandoned_camp structure tag."
    },
    "Selection cleared" : {
      "comment" : "VoiceOver announcement after an empty-map click or map-focused Escape clears the selected row. An in-game map overlay may remain visible."
    },
    "Choose your Minecraft folder (usually Library ▸ Application Support ▸ minecraft in your home folder) to use saved player names, item pictures and map colors. Pictures and colors come from the newest installed release, or the newest installed version if no release is installed. Missing pictures use symbols; unavailable map colors use the standard palette." : {
      "comment" : "Settings explanation: artwork uses the newest installed Minecraft release, falling back to the newest installed version when no release is present."
    },
    "The return link is unknown." : {
      "comment" : "Portal inspector: the outward destination is known, but the return scan or its dimension facts are unavailable."
    },
    "Increase Y Level" : {
      "comment" : "View menu command: raise the remembered cutaway height by one block and enter Cutaway, including from Surface."
    },
    "Decrease Y Level" : {
      "comment" : "View menu command: lower the remembered cutaway height by one block and enter Cutaway, including from Surface."
    },
    "Dark Spots" : {
      "comment" : "Opt-in map layer showing clear-night light eligibility; not a complete monster spawnability test."
    },
    "Dark Spots at Night" : {
      "comment" : "Map legend key for red tinted columns whose light can pass the ordinary monster check at night."
    },
    "Light Unknown" : {
      "comment" : "Map legend key for striped columns with missing, stale or unsupported light facts."
    },
    "Nighttime light unknown" : {
      "comment" : "Hover readout when the saved light or dimension rules cannot be resolved."
    },
    "Too bright for ordinary monsters at night" : {
      "comment" : "Hover readout for light that rules out the ordinary monster check; other mob rules differ."
    },
    "Light low enough for ordinary monsters at night" : {
      "comment" : "Hover readout for possible light eligibility; this does not check terrain or other spawning conditions."
    },
    "Light above the displayed surface at night. Other spawning conditions are not checked." : {
      "comment" : "Explanation shared by the map layer tooltip, legend and accessibility description."
    },
    "Dark Spots shown. %@" : {
      "comment" : "Map accessibility value; the placeholder is the localized Dark Spots explanation."
    },
    "Lighting" : {
      "comment" : "View menu containing the saved-world lighting and constant Daylight choices."
    },
    "Saved Time" : {
      "comment" : "Light the map using the world's most recently saved sun and moon attributes. This does not simulate a clock."
    },
    "Daylight" : {
      "comment" : "Map lighting preference with constant, readable daytime colors."
    },
    "Lighting follows the world's last save. Choose Daylight in the View menu for constant lighting." : {
      "comment" : "Help for the saved-time map legend."
    },
    "Full Moon" : {
      "comment" : "The saved moon phase, shown with the map lighting legend."
    },
    "Waning Gibbous" : {
      "comment" : "The saved moon phase, shown with the map lighting legend."
    },
    "Third Quarter" : {
      "comment" : "The saved moon phase, shown with the map lighting legend."
    },
    "Waning Crescent" : {
      "comment" : "The saved moon phase, shown with the map lighting legend."
    },
    "New Moon" : {
      "comment" : "The saved moon phase, shown with the map lighting legend."
    },
    "Waxing Crescent" : {
      "comment" : "The saved moon phase, shown with the map lighting legend."
    },
    "First Quarter" : {
      "comment" : "The saved moon phase, shown with the map lighting legend."
    },
    "Waxing Gibbous" : {
      "comment" : "The saved moon phase, shown with the map lighting legend."
    },
    "Durability" : {
      "comment" : "Equipment gauge label. Its value is the remaining durability out of the maximum."
    },
    "%@ of %@" : {
      "comment" : "A durability gauge's remaining and maximum points, already formatted as localized numbers. The row separately labels this value Durability."
    },
    "%@, %@" : {
      "comment" : "A pet's appearance: its coat or variant, followed by its markings."
    },
    "Location unknown" : {
      "comment" : "A saved item or player has no usable coordinates; also used for a shoulder pet whose carrier cannot be located. This is different from a known location in a missing dimension."
    },
    "Player %@" : {
      "comment" : "An unnamed player, identified by the first eight characters of the saved player ID. Shared by player rows and unknown pet owners."
    },
    "%@ (not in this world)" : {
      "comment" : "An unnamed pet owner without a player record in this save. The placeholder is the same Player plus short ID label used for unnamed players."
    },
    "Profession" : {
      "comment" : "A villager's saved profession, with its trading rank when applicable."
    },
    "Map of %@ in %@" : {
      "comment" : "Shared title for the map's accessibility label and image-sharing preview. The first placeholder is the dimension's readable, collision-safe name; the second is the world's saved name."
    },
    "%@ (first %lld of %lld)" : {
      "comment" : "A search heading when only the first results are listed. The first placeholder is the heading or user's saved query; the numbers are the shown count and total count."
    },
    "Search Result" : {
      "comment" : "Inspector section containing the selected search match's details."
    },
    "Found In" : {
      "comment" : "Identifies whether the selected search match is in this player's inventory or Ender Chest."
    },
    "Spawns" : {
      "comment" : "Inspector label for the mob produced by a selected monster spawner."
    },
    "Claimed by a Villager" : {
      "comment" : "Whether a selected bed or workstation has been claimed by a villager."
    },
    "All Statistics" : {
      "comment" : "Heading of the sheet listing every saved statistic for the selected player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Statistics"
          }
        }
      }
    },
    "Value" : {
      "comment" : "Statistics table column containing a count or a value with its unit.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Value"
          }
        }
      }
    },
    "%@ for %@" : {
      "comment" : "A villager's trade offer, shared by its inspector and search results. The first placeholder is the received item and quantity; the second is the requested cost, which can include two items."
    },
    "%@ (sold out)" : {
      "comment" : "A complete villager trade offer followed by its saved sold-out status."
    },
    "%@ + %@" : {
      "comment" : "The two item quantities required by one villager trade. Both placeholders include the item name and quantity."
    },
    "%@ (%@)" : {
      "comment" : "An item name and quantity followed by its enchantment descriptions in parentheses."
    },
    "Set a measurement point." : {
      "comment" : "Accessibility hint for a map marker while the distance ruler is on. Activating the marker sets a ruler endpoint at its saved location."
    },
    "Center the map on this location." : {
      "comment" : "Accessibility hint for a map marker. Activating the marker centers the map on its saved location. The period belongs to the spoken hint, unlike the corresponding tooltip."
    },
    "%@ (%lld)" : {
      "comment" : "A sidebar group or saved-search heading followed by its result count. The first placeholder is an already named group or the user's literal search query; do not translate the placeholder's contents."
    },
    "In about %@ of play" : {
      "comment" : "Approximate saved delay until the next wandering-trader spawn attempt. The placeholder is a fully localized duration in whole minutes, including its unit, such as 1 minute or 60 minutes."
    },
    "Within a minute of play" : {
      "comment" : "The saved wandering-trader delay is less than one minute; this is a chance to spawn, not a guarantee."
    },
    "Unopened Loot" : {
      "comment" : "Group and fallback name for a container whose loot has not been generated yet."
    },
    "Monster Room Loot" : {
      "comment" : "Unopened container using Minecraft’s simple_dungeon loot table; not a prediction of its contents or surroundings."
    },
    "Mineshaft Loot" : {
      "comment" : "Unopened container using the abandoned_mineshaft loot table."
    },
    "Desert Pyramid Loot" : {
      "comment" : "Unopened container using the desert_pyramid loot table."
    },
    "Jungle Pyramid Loot" : {
      "comment" : "Unopened container using the jungle_temple loot table."
    },
    "Buried Treasure Loot" : {
      "comment" : "Unopened container using the buried_treasure loot table."
    },
    "Shipwreck Treasure Loot" : {
      "comment" : "Unopened container using the shipwreck_treasure loot table."
    },
    "Shipwreck Supply Loot" : {
      "comment" : "Unopened container using the shipwreck_supply loot table."
    },
    "Shipwreck Map Loot" : {
      "comment" : "Unopened container using the shipwreck_map loot table."
    },
    "%@ Loot" : {
      "comment" : "Readable vanilla loot-table name followed by Loot. The placeholder is the saved table name."
    },
    "Loot: %@" : {
      "comment" : "Fallback unopened-loot label; the placeholder is an unfamiliar saved loot-table identifier."
    },
    "World Border" : {
      "comment" : "Map overlay visibility control in the View menu and sidebar."
    },
    "Show the saved world border when it is smaller than the default limit" : {
      "comment" : "Help for the World Border map visibility control."
    },
    "Done" : {
      "comment" : "Finish the current view or popover. Map adjustments retain valid entries."
    },
    "Mode" : {
      "comment" : "The Map Height control chooses Surface or Cutaway; its separate Y coordinate controls choose the height."
    },
    "Y coordinate" : {
      "comment" : "The map's vertical block coordinate, shared by its number field and height slider."
    },
    "Height range unavailable" : {
      "comment" : "Shown instead of the cutaway slider when the dimension's build limits cannot be read. Numeric entry remains available."
    },
    "X Z or X Y Z" : {
      "comment" : "Coordinate-entry placeholder. Two numbers specify horizontal coordinates; three numbers use Minecraft's X Y Z order. Keep the axis letters and spaces."
    },
    "Enter X Z or X Y Z in %@." : {
      "comment" : "Coordinate-entry instructions, followed by the current dimension's name. Keep the Minecraft axis letters in this order; the format stays visible even while the field contains a value."
    },
    "Enter whole block coordinates separated by spaces; Y is optional" : {
      "comment" : "Help for a coordinate field that accepts typed or pasted block coordinates. Y is optional; it updates the selected height without switching Surface/Cutaway mode."
    },
    "Choose within this dimension’s build height, or type any Y coordinate below" : {
      "comment" : "Help for the height slider; numeric entry can go outside the dimension's verified slider bounds."
    },
    "%lld chunks" : {
      "comment" : "Number of neighboring chunks in one biome area.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld chunk"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld chunks"
                }
              }
            }
          }
        }
      }
    },
    "%lld × %lld blocks" : {
      "comment" : "The width and height covered by a saved Minecraft map, in blocks. Both dimensions are at least 128 blocks."
    },
    "1 pixel for every %@" : {
      "comment" : "The scale of a saved Minecraft map. The placeholder is a localized block count including its unit, such as 1 block or 16 blocks."
    },
    "%@ wide, centered at %@" : {
      "comment" : "A dimension's limited world border. The first placeholder is a localized block count including its unit; the second is the center's X and Z coordinates."
    },
    "%lld blocks · Y %lld to %lld" : {
      "comment" : "Block deposit count followed by its minimum and maximum height. Pluralize only the first argument.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
