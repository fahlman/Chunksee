      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chunksee shows the terrain, places, pets and players in a saved Java Edition world. It only reads your world; it never changes it."
          }
        }
      }
    },
    "Drag or scroll to move. Pinch to zoom, or click the toolbar’s zoom percentage to choose a level or Fit World." : {
