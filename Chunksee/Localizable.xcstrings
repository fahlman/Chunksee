              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld blocks · Y %2$lld to %3$lld"
                }
              }
            }
          }
        }
      }
    },
    "%lld kinds of items in %lld containers": {
      "comment": "Storage summary. The item-kind and container counts vary independently.",
