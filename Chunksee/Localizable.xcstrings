    "Choose File ▸ Open… and select one world’s folder inside your saves folder." : {
      "comment" : "On-demand Help instructions.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose File ▸ Open… and select one world’s folder inside your saves folder."
          }
        }
      }
    },
    "Chunksee Help" : {
      "comment" : "On-demand Help instructions.",
      "extractionState" : "manual",
